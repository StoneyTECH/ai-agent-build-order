{
  "name": "build-order",
  "version": "0.1.0",
  "description": "Audit an AI agent build against the nine-gate Build Order. Static where detectable, attested where not, every gate labeled which. Proof-of-work companion to 'Everything Gets Rebuilt'.",
  "type": "module",
  "bin": {
    "build-order": "bin/build-order.mjs"
  },
  "exports": {
    ".": "./src/audit.mjs",
    "./crosswalk.v1.json": "./crosswalk.v1.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "mcp/",
    "crosswalk.v1.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StoneyTECH/ai-agent-build-order.git"
  },
  "homepage": "https://github.com/StoneyTECH/ai-agent-build-order#readme",
  "bugs": {
    "url": "https://github.com/StoneyTECH/ai-agent-build-order/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "node --test",
    "demo": "node bin/build-order.mjs audit examples/leaky-agent --out examples/leaky-agent/SCORECARD.md || true",
    "self-audit": "node bin/build-order.mjs audit . --attest attestation.json --ignore examples",
    "mcp": "node mcp/build-order-mcp.mjs"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "license": "MIT",
  "keywords": [
    "ai-assurance",
    "agent-security",
    "mcp",
    "determinism-ladder",
    "secure-by-design",
    "audit",
    "secure-by-default"
  ]
}
